{
  "version": 2,
  "buildCommand": "node scripts/generate-sitemap.js",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    },
    "api/unlock-prompts.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/100-prompts/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
